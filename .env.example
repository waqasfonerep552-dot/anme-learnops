APP_NAME="ANME LearnOps"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=learnops
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

LEARNOPS_ADMIN_EMAIL=admin@example.com
LEARNOPS_ADMIN_PASSWORD=change-me

MOODLE_BASE_URL=http://moodle.test
MOODLE_REST_URL=http://moodle.test/webservice/rest/server.php
MOODLE_WS_TOKEN=your_moodle_token_here
MOODLE_TIMEOUT=15
MOODLE_HMAC_ENABLED=false
MOODLE_HMAC_SECRET=
MOODLE_HMAC_TIMESTAMP_WINDOW=300
MOODLE_FN_CREATE_USER=local_custom_webservice_create_user
MOODLE_FN_ENROL_USER=local_custom_webservice_enrol_user
MOODLE_FN_SUSPEND_USER=local_custom_webservice_suspend_user
MOODLE_FN_USER_PROGRESS=local_custom_webservice_get_course_users_progress
MOODLE_FN_COURSES=core_course_get_courses
MOODLE_FN_CATEGORIES=core_course_get_categories
MOODLE_FN_USERS_BY_FIELD=core_user_get_users_by_field
MOODLE_FN_UPDATE_USERS=core_user_update_users

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

EASYPAISA_MODE=sandbox
EASYPAISA_STORE_ID=
EASYPAISA_MERCHANT_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_CHECKOUT_URL=
EASYPAISA_RETURN_URL="${APP_URL}/payments/easypaisa/return"
EASYPAISA_WEBHOOK_SECRET=
EASYPAISA_CALLBACK_WINDOW=300
EASYPAISA_ALLOW_LOCAL_PAID_SIMULATION=false
